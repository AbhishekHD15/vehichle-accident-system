# ==============================================================================
# Root .gitignore for Vehicle Accident Detection & Insurance Management System
# ==============================================================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*.swp
*~

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Secrets (NEVER commit secrets!)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# ==============================================================================
# Python / Backend (accident-cloud)
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Database files
*.db
*.sqlite
*.sqlite3

# ==============================================================================
# Node.js / Frontend
# ==============================================================================
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.eslintcache
frontend/.stylelintcache
*.local

# ==============================================================================
# ESP32 / PlatformIO (firmware)
# ==============================================================================
.pio/
firmware/.pio/
firmware/src/secrets.h
firmware/src/ca.pem
.clangd/
*.bin
*.elf
*.hex

